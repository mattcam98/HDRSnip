<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light palette. Key-for-key mirror of Dark.xaml; accents are darkened so
       they keep 4.5:1 contrast against light surfaces. -->

  <SolidColorBrush x:Key="Surface.Base"    Color="#FFF5F5F7" />
  <SolidColorBrush x:Key="Surface.Layer"   Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Surface.Overlay" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Surface.Input"   Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Surface.Canvas"  Color="#FFE9E9ED" />

  <SolidColorBrush x:Key="Stroke.Subtle"  Color="#12000000" />
  <SolidColorBrush x:Key="Stroke.Default" Color="#26000000" />
  <SolidColorBrush x:Key="Stroke.Strong"  Color="#40000000" />

  <SolidColorBrush x:Key="Text.Primary"   Color="#FF14141A" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#FF5A5D68" />
  <SolidColorBrush x:Key="Text.Tertiary"  Color="#FF8A8D96" />
  <SolidColorBrush x:Key="Text.OnAccent"  Color="#FFFFFFFF" />

  <SolidColorBrush x:Key="Accent.Default" Color="#FF0F7FBF" />
  <SolidColorBrush x:Key="Accent.Muted"   Color="#280F7FBF" />

  <SolidColorBrush x:Key="Control.Fill"        Color="#08000000" />
  <SolidColorBrush x:Key="Control.FillHover"   Color="#14000000" />
  <SolidColorBrush x:Key="Control.FillPressed" Color="#05000000" />

</ResourceDictionary>
