<Window x:Class="HDRSnip.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HDRSnip.Controls"
        Title="HDRSnip settings"
        Width="560" Height="720"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <!-- Section heading above each card. -->
    <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Type.Subtitle}">
      <Setter Property="Margin" Value="2,0,0,8" />
    </Style>
    <Style x:Key="Row" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- Footer stays pinned so Save is always reachable. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Surface.Layer}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="20,14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   x:Name="VersionLabel"
                   Style="{StaticResource Type.Caption}"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource Button.Standard}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
          <Button Content="Save" Style="{StaticResource Button.Accent}" Click="OnSave" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Padding="20,20,14,20" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- ============================================== Capture -->
        <TextBlock Text="Capture" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
          <StackPanel>
            <StackPanel Style="{StaticResource Row}">
              <TextBlock Text="Save folder" Style="{StaticResource Type.Body}" Margin="0,0,0,6" />
              <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Browse…"
                        Style="{StaticResource Button.Standard}"
                        Click="OnBrowse"
                        MinWidth="0"
                        Padding="12,7"
                        Margin="8,0,0,0" />
                <TextBox x:Name="SaveFolderBox" Style="{StaticResource Field.TextBox}" />
              </DockPanel>
            </StackPanel>

            <CheckBox x:Name="CopyToggle"
                      Style="{StaticResource Field.Toggle}"
                      Content="Copy to clipboard after capture"
                      Margin="0,0,0,14" />

            <CheckBox x:Name="AutoSaveToggle"
                      Style="{StaticResource Field.Toggle}"
                      Content="Also save a PNG automatically"
                      Margin="0,0,0,14" />

            <CheckBox x:Name="CursorToggle"
                      Style="{StaticResource Field.Toggle}"
                      Content="Include the mouse pointer"
                      Margin="0,0,0,14" />

            <CheckBox x:Name="AdjustToggle"
                      Style="{StaticResource Field.Toggle}"
                      Content="Adjust a region before capturing it"
                      Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Type.Caption}"
                       Margin="0,0,0,14"
                       Text="Keeps the dragged region on screen with handles. Arrow keys nudge it, Enter or a double-click captures." />

            <CheckBox x:Name="EditorToggle"
                      Style="{StaticResource Field.Toggle}"
                      Content="Open the editor instead of showing a toast"
                      Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Type.Caption}"
                       Text="By default a notification appears; clicking it opens the editor. Either way the capture is already on the clipboard." />
          </StackPanel>
        </Border>

        <!-- ============================================== Tone mapping -->
        <TextBlock Text="HDR tone mapping" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
          <StackPanel>
            <StackPanel Style="{StaticResource Row}">
              <TextBlock Text="Curve" Style="{StaticResource Type.Body}" Margin="0,0,0,6" />
              <ComboBox x:Name="ToneMapBox" Style="{StaticResource Field.ComboBox}" SelectionChanged="OnCurveChanged">
                <ComboBoxItem Content="Windows / OBS — best for UI and text" />
                <ComboBoxItem Content="ACES filmic — best for games and video" />
                <ComboBoxItem Content="Reinhard — softest highlight rolloff" />
              </ComboBox>
            </StackPanel>

            <StackPanel x:Name="NitsRow">
              <CheckBox x:Name="AutoWhiteToggle"
                        Style="{StaticResource Field.Toggle}"
                        Content="Match each monitor's Windows SDR brightness"
                        Checked="OnAutoWhiteChanged"
                        Unchecked="OnAutoWhiteChanged"
                        Margin="0,0,0,14" />
              <StackPanel x:Name="ManualWhite">
                <DockPanel Margin="0,0,0,2">
                  <TextBlock Text="SDR white level" Style="{StaticResource Type.Body}" />
                  <TextBlock x:Name="NitsLabel"
                             Style="{StaticResource Type.Body}"
                             Foreground="{DynamicResource Accent.Default}"
                             HorizontalAlignment="Right"
                             TextAlignment="Right"
                             MinWidth="64" />
                </DockPanel>
                <Slider x:Name="NitsSlider"
                        Style="{StaticResource Field.Slider}"
                        Minimum="120" Maximum="480"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnNitsChanged" />
              </StackPanel>
              <TextBlock Style="{StaticResource Type.Caption}"
                         Text="HDRSnip reads the SDR content brightness Windows uses for the monitor being captured. Turn this off to set a fixed level: higher values darken the result." />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============================================== Hotkeys -->
        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Region snip" Style="{StaticResource Type.Body}" VerticalAlignment="Center" />
              <controls:HotkeyBox x:Name="RegionHotkey"
                                  Style="{StaticResource Button.Standard}"
                                  HorizontalAlignment="Right"
                                  MinWidth="180" />
            </DockPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Full screen" Style="{StaticResource Type.Body}" VerticalAlignment="Center" />
              <controls:HotkeyBox x:Name="FullScreenHotkey"
                                  Style="{StaticResource Button.Standard}"
                                  HorizontalAlignment="Right"
                                  MinWidth="180" />
            </DockPanel>
            <TextBlock Style="{StaticResource Type.Caption}"
                       Text="Click a hotkey then press the combination you want. Backspace clears it, Esc keeps the current one. Win+Shift+S is reserved by Windows and cannot be claimed." />
          </StackPanel>
        </Border>

        <!-- ============================================== System -->
        <TextBlock Text="System" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <CheckBox x:Name="AutostartToggle"
                      Style="{StaticResource Field.Toggle}"
                      Content="Start HDRSnip when I sign in"
                      Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Type.Caption}"
                       Text="HDRSnip lives in the notification area and uses no CPU while idle." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
