<Window x:Class="HDRSnip.Views.ModeBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDRSnip"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        AllowsTransparency="True"
        KeyDown="OnKeyDown">

  <!-- Floating mode picker. Margin leaves room for the shadow to render
       inside the transparent window bounds. -->
  <Border Margin="24,16,24,24"
          Background="{DynamicResource Surface.Overlay}"
          BorderBrush="{DynamicResource Stroke.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Flyout}"
          Padding="6">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000" />
    </Border.Effect>

    <StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource Button.Subtle}"
              Click="OnRectangle"
              Padding="14,10"
              ToolTip="Drag a rectangle over the area you want (R)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE123;" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Type.Body}" Text="Region" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Type.Caption}" Text="R" Margin="10,1,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Style="{StaticResource Button.Subtle}"
              Click="OnFullScreen"
              Padding="14,10"
              ToolTip="Capture the whole monitor under the cursor (F)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Type.Body}" Text="Full screen" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Type.Caption}" Text="F" Margin="10,1,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border Width="1" Margin="6,8" Background="{DynamicResource Stroke.Subtle}" />

      <Button Style="{StaticResource Button.Subtle}"
              Click="OnDelay"
              Padding="12,10"
              ToolTip="Wait before capturing, to catch menus and hover states (D)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="DelayLabel" Style="{StaticResource Type.Body}" MinWidth="52" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border Width="1" Margin="6,8" Background="{DynamicResource Stroke.Subtle}" />

      <Button Style="{StaticResource Button.Icon}" Click="OnClose" ToolTip="Close (Esc)">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="12" />
      </Button>
    </StackPanel>
  </Border>
</Window>
