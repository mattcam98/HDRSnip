<Window x:Class="HDRSnip.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDRSnip"
        Width="1000" Height="700"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        KeyDown="OnKeyDown">
  <DockPanel>

    <!-- Command bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Surface.Layer}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="HdrBadge"
                  Background="{DynamicResource Accent.Muted}"
                  BorderBrush="{DynamicResource Accent.Default}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Small}"
                  Padding="8,3"
                  VerticalAlignment="Center">
            <TextBlock x:Name="HdrBadgeText"
                       Style="{StaticResource Type.Caption}"
                       Foreground="{DynamicResource Accent.Default}"
                       Text="HDR tone-mapped" />
          </Border>
          <TextBlock x:Name="Dimensions"
                     Style="{StaticResource Type.Secondary}"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Button.Icon}" Click="OnZoomOut" ToolTip="Zoom out (Ctrl+-)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" FontSize="13" />
          </Button>
          <Button Style="{StaticResource Button.Subtle}" Click="OnToggleZoom" MinWidth="58"
                  ToolTip="Toggle fit / actual size (Ctrl+0)">
            <TextBlock x:Name="ZoomLabel" Style="{StaticResource Type.Body}" Text="Fit" />
          </Button>
          <Button Style="{StaticResource Button.Icon}" Click="OnZoomIn" ToolTip="Zoom in (Ctrl++)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71E;" FontSize="13" />
          </Button>

          <Border Width="1" Margin="10,4" Background="{DynamicResource Stroke.Subtle}" />

          <Button Style="{StaticResource Button.Standard}" Click="OnCopy" Margin="0,0,8,0" MinWidth="0" Padding="12,7">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Type.Body}" Text="Copy" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Standard}" Click="OnSaveAs" Margin="0,0,8,0" MinWidth="0" Padding="12,7"
                  ToolTip="Save to a chosen location (Ctrl+Shift+S)">
            <TextBlock Style="{StaticResource Type.Body}" Text="Save as…" />
          </Button>
          <Button Style="{StaticResource Button.Accent}" Click="OnSave" MinWidth="0" Padding="14,7"
                  ToolTip="Save to the captures folder (Ctrl+S)">
            <TextBlock Text="Save" Foreground="{DynamicResource Text.OnAccent}" FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Surface.Layer}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="14,8">
      <TextBlock x:Name="Status" Style="{StaticResource Type.Secondary}" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Canvas -->
    <ScrollViewer x:Name="Viewport"
                  Background="{DynamicResource Surface.Canvas}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnViewportWheel"
                  SizeChanged="OnViewportSizeChanged">
      <Border Padding="28">
        <Border BorderBrush="{DynamicResource Stroke.Default}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" />
          </Border.Effect>
          <Image x:Name="Preview"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
