<Window x:Class="HDRSnip.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="clr-namespace:HDRSnip.Editing"
        Title="HDRSnip"
        Width="1000" Height="720"
        MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        KeyDown="OnKeyDown"
        Closing="OnClosing">
  <DockPanel>

    <!-- Command bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Surface.Layer}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HdrBadge" Style="{StaticResource Button.Subtle}" Click="OnOpenTone" Padding="0"
                  VerticalAlignment="Center" ToolTip="Change how this HDR capture is tone-mapped">
            <Border Background="{DynamicResource Accent.Muted}"
                    BorderBrush="{DynamicResource Accent.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Small}"
                    Padding="8,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource Accent.Default}"
                           Text="HDR tone-mapped" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="8" Margin="6,1,0,0"
                           Foreground="{DynamicResource Accent.Default}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Button>
          <Popup x:Name="ToneFlyout"
                 PlacementTarget="{Binding ElementName=HdrBadge}"
                 Placement="Bottom"
                 HorizontalOffset="-12"
                 VerticalOffset="-2"
                 StaysOpen="False"
                 AllowsTransparency="True"
                 PopupAnimation="Fade">
            <Border Style="{StaticResource Flyout}">
              <StackPanel Width="250">
                <TextBlock Style="{StaticResource Type.Subtitle}" Text="Tone-mapping curve" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Tool.Button}" Width="NaN" GroupName="Tone" Tag="Windows" Checked="OnToneChecked"
                               ToolTip="Best for UI and text">
                    <TextBlock Style="{StaticResource Type.Body}" Text="Windows" Margin="12,0" />
                  </RadioButton>
                  <RadioButton Style="{StaticResource Tool.Button}" Width="NaN" GroupName="Tone" Tag="Aces" Checked="OnToneChecked"
                               ToolTip="Filmic; best for games and video">
                    <TextBlock Style="{StaticResource Type.Body}" Text="ACES" Margin="12,0" />
                  </RadioButton>
                  <RadioButton Style="{StaticResource Tool.Button}" Width="NaN" GroupName="Tone" Tag="Reinhard" Checked="OnToneChecked"
                               ToolTip="Softest highlight rolloff">
                    <TextBlock Style="{StaticResource Type.Body}" Text="Reinhard" Margin="12,0" />
                  </RadioButton>
                </StackPanel>

                <StackPanel x:Name="ToneWhitePanel" Margin="0,14,0,0">
                  <DockPanel>
                    <TextBlock Style="{StaticResource Type.Subtitle}" Text="SDR white level" />
                    <TextBlock x:Name="ToneWhiteLabel" Style="{StaticResource Type.Secondary}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider x:Name="ToneWhiteSlider"
                          Style="{StaticResource Field.Slider}"
                          Focusable="False"
                          Minimum="80" Maximum="480"
                          TickFrequency="10"
                          IsSnapToTickEnabled="True"
                          Margin="0,4,0,0"
                          ValueChanged="OnToneWhiteChanged" />
                  <TextBlock Style="{StaticResource Type.Caption}" Text="Higher values darken the image." />
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
          <TextBlock x:Name="Dimensions"
                     Style="{StaticResource Type.Secondary}"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0" />
          <TextBlock x:Name="EditedBadge"
                     Style="{StaticResource Type.Caption}"
                     Text="· edited"
                     VerticalAlignment="Center"
                     Margin="6,0,0,0"
                     Visibility="Collapsed" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Button.Icon}" Click="OnZoomOut" ToolTip="Zoom out (Ctrl+-)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" FontSize="13" />
          </Button>
          <Button Style="{StaticResource Button.Subtle}" Click="OnToggleZoom" MinWidth="58"
                  ToolTip="Toggle fit / actual size (Ctrl+0)">
            <TextBlock x:Name="ZoomLabel" Style="{StaticResource Type.Body}" Text="Fit" />
          </Button>
          <Button Style="{StaticResource Button.Icon}" Click="OnZoomIn" ToolTip="Zoom in (Ctrl++)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71E;" FontSize="13" />
          </Button>

          <Border Width="1" Margin="10,4" Background="{DynamicResource Stroke.Subtle}" />

          <Border x:Name="DragGrip" Background="Transparent" Cursor="SizeAll" Padding="9,8" Margin="0,0,4,0"
                  CornerRadius="{StaticResource Radius.Control}"
                  MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                  ToolTip="Drag from here into another app or a folder">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE784;" FontSize="14" Foreground="{DynamicResource Text.Secondary}" />
          </Border>
          <Button x:Name="CopyTextButton" Style="{StaticResource Button.Subtle}" Click="OnCopyText" Margin="0,0,8,0" Padding="10,7"
                  ToolTip="Recognise the text in this capture and copy it. Runs on this PC">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E9;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Type.Body}" Text="Copy text" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Icon}" Click="OnPin" Margin="0,0,8,0"
                  ToolTip="Pin to the screen, above other windows">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="14" />
          </Button>
          <Button Style="{StaticResource Button.Standard}" Click="OnCopy" Margin="0,0,8,0" MinWidth="0" Padding="12,7"
                  ToolTip="Copy the image with its markup (Ctrl+C)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Type.Body}" Text="Copy" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Standard}" Click="OnSaveAs" Margin="0,0,8,0" MinWidth="0" Padding="12,7"
                  ToolTip="Save to a chosen location (Ctrl+Shift+S)">
            <TextBlock Style="{StaticResource Type.Body}" Text="Save as…" />
          </Button>
          <Button Style="{StaticResource Button.Accent}" Click="OnSave" MinWidth="0" Padding="14,7"
                  ToolTip="Save to the captures folder (Ctrl+S)">
            <TextBlock Text="Save" Foreground="{DynamicResource Text.OnAccent}" FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Markup toolbar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Surface.Layer}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <DockPanel>

        <!-- History, right -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="UndoButton" Style="{StaticResource Button.Icon}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" FontSize="14" />
          </Button>
          <Button x:Name="RedoButton" Style="{StaticResource Button.Icon}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" FontSize="14" />
          </Button>
          <Border Width="1" Margin="8,6" Background="{DynamicResource Stroke.Subtle}" />
          <Button x:Name="ClearButton" Style="{StaticResource Button.Icon}" Click="OnClear" ToolTip="Remove all markup">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
          </Button>
        </StackPanel>

        <!-- Crop confirmation, only while the crop tool is armed -->
        <StackPanel x:Name="CropActions" DockPanel.Dock="Right" Orientation="Horizontal"
                    Margin="0,0,12,0" Visibility="Collapsed">
          <Button Style="{StaticResource Button.Subtle}" Click="OnCancelCrop" Padding="10,6" ToolTip="Keep the current crop (Esc)">
            <TextBlock Style="{StaticResource Type.Body}" Text="Cancel" />
          </Button>
          <Button Style="{StaticResource Button.Accent}" Click="OnApplyCrop" Padding="12,6" MinWidth="0" Margin="6,0,0,0"
                  ToolTip="Apply the crop (Enter)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource Text.OnAccent}" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Apply crop" Foreground="{DynamicResource Text.OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Tools, left -->
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Select" IsChecked="True" Checked="OnToolChecked"
                       ToolTip="Select (V) — click a mark to move, restyle or delete it">
            <TextBlock Style="{StaticResource Glyph.Tool}" Text="&#xE8B0;" />
          </RadioButton>

          <Border Width="1" Margin="6,6" Background="{DynamicResource Stroke.Subtle}" />

          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Pen" Checked="OnToolChecked" ToolTip="Pen (P)">
            <TextBlock Style="{StaticResource Glyph.Tool}" Text="&#xE70F;" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Highlighter" Checked="OnToolChecked" ToolTip="Highlighter (H)">
            <TextBlock Style="{StaticResource Glyph.Tool}" Text="&#xE7E6;" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Line" Checked="OnToolChecked" ToolTip="Line (L)">
            <Path Style="{StaticResource Icon.Tool}" Data="M 2,14 L 14,2" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Arrow" Checked="OnToolChecked" ToolTip="Arrow (A)">
            <Path Style="{StaticResource Icon.Tool}" Data="M 2,14 L 14,2 M 7,2 L 14,2 L 14,9" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Rectangle" Checked="OnToolChecked" ToolTip="Rectangle (R)">
            <Path Style="{StaticResource Icon.Tool}" Data="M 2.5,3.5 H 13.5 V 12.5 H 2.5 Z" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Ellipse" Checked="OnToolChecked" ToolTip="Ellipse (E)">
            <Path Style="{StaticResource Icon.Tool}" Data="M 8,2.5 A 5.5,5.5 0 1 1 8,13.5 A 5.5,5.5 0 1 1 8,2.5 Z" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Text" Checked="OnToolChecked" ToolTip="Text (T)">
            <TextBlock Style="{StaticResource Glyph.Tool}" Text="&#xE8D2;" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Number" Checked="OnToolChecked"
                       ToolTip="Numbered step (N) — each click places the next number">
            <Path Style="{StaticResource Icon.Tool}" StrokeThickness="1.4"
                  Data="M 8,1.5 A 6.5,6.5 0 1 1 8,14.5 A 6.5,6.5 0 1 1 8,1.5 Z M 6.6,6 L 8.4,4.8 V 11.2" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Pixelate" Checked="OnToolChecked"
                       ToolTip="Redact (X) — pixelate, blur or cover something sensitive">
            <Path Style="{StaticResource Icon.Tool}" StrokeThickness="1.3"
                  Data="M 2.5,2.5 H 13.5 V 13.5 H 2.5 Z M 6.2,2.5 V 13.5 M 9.8,2.5 V 13.5 M 2.5,6.2 H 13.5 M 2.5,9.8 H 13.5" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Spotlight" Checked="OnToolChecked"
                       ToolTip="Spotlight (F) — dim everything outside an area">
            <Path Style="{StaticResource Icon.Tool}" StrokeThickness="1.3"
                  Data="M 1.5,2.5 H 14.5 V 13.5 H 1.5 Z M 5,5.5 H 11 V 10.5 H 5 Z M 1.5,2.5 L 5,5.5 M 14.5,2.5 L 11,5.5 M 14.5,13.5 L 11,10.5 M 1.5,13.5 L 5,10.5" />
          </RadioButton>

          <Border Width="1" Margin="6,6" Background="{DynamicResource Stroke.Subtle}" />

          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Crop" Checked="OnToolChecked" ToolTip="Crop (C)">
            <TextBlock Style="{StaticResource Glyph.Tool}" Text="&#xE7A8;" />
          </RadioButton>
          <RadioButton Style="{StaticResource Tool.Button}" GroupName="Tool" Tag="Eyedropper" Checked="OnToolChecked"
                       ToolTip="Colour picker (I) — click a pixel to copy its hex colour">
            <TextBlock Style="{StaticResource Glyph.Tool}" Text="&#xEF3C;" />
          </RadioButton>

          <Border Width="1" Margin="6,6" Background="{DynamicResource Stroke.Subtle}" />

          <!-- Colour and size chip; opens the style flyout -->
          <Button x:Name="StyleButton" Style="{StaticResource Button.Subtle}" Click="OnOpenStyle"
                  Height="34" Padding="10,0" ToolTip="Style of the current tool or selected mark (S)">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StyleDot" Width="14" Height="14"
                       Stroke="{DynamicResource Stroke.Strong}" StrokeThickness="1" />
              <TextBlock x:Name="StyleSizeLabel" Style="{StaticResource Type.Secondary}" Margin="8,0,6,0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9"
                         Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Popup x:Name="StyleFlyout"
                 PlacementTarget="{Binding ElementName=StyleButton}"
                 Placement="Bottom"
                 HorizontalOffset="-12"
                 VerticalOffset="-4"
                 StaysOpen="False"
                 AllowsTransparency="True"
                 PopupAnimation="Fade"
                 Opened="OnStyleFlyoutOpened">
            <Border Style="{StaticResource Flyout}">
              <StackPanel Width="212">
                <StackPanel x:Name="RedactPanel" Margin="0,0,0,12">
                  <TextBlock Style="{StaticResource Type.Subtitle}" Text="Hide with" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Tool.Button}" Width="NaN" Focusable="False" GroupName="Redact" Tag="Pixelate" Checked="OnRedactChecked">
                      <TextBlock Style="{StaticResource Type.Body}" Text="Pixels" Margin="12,0" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Tool.Button}" Width="NaN" Focusable="False" GroupName="Redact" Tag="Blur" Checked="OnRedactChecked">
                      <TextBlock Style="{StaticResource Type.Body}" Text="Blur" Margin="12,0" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Tool.Button}" Width="NaN" Focusable="False" GroupName="Redact" Tag="Solid" Checked="OnRedactChecked">
                      <TextBlock Style="{StaticResource Type.Body}" Text="Solid" Margin="12,0" />
                    </RadioButton>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Type.Caption}" Margin="0,8,0,0"
                             Text="Pixelated or blurred text can sometimes be recovered. Solid cannot." />
                </StackPanel>

                <StackPanel x:Name="ColorPanel">
                  <TextBlock Style="{StaticResource Type.Subtitle}" Text="Colour" Margin="0,0,0,8" />
                  <UniformGrid x:Name="Swatches" Columns="6" HorizontalAlignment="Left" />
                </StackPanel>

                <CheckBox x:Name="FillToggle"
                          Style="{StaticResource Field.Toggle}"
                          Focusable="False"
                          Content="Fill"
                          Margin="0,14,0,0"
                          Checked="OnFillChanged"
                          Unchecked="OnFillChanged" />

                <StackPanel x:Name="SizePanel">
                <TextBlock Style="{StaticResource Type.Subtitle}" Text="Size" Margin="0,14,0,4" />
                <Grid Height="56" ClipToBounds="True">
                  <Path x:Name="SizePreviewStroke"
                        Data="M 8,40 C 46,-2 86,58 126,28 S 186,8 204,30"
                        Stretch="None"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  <TextBlock x:Name="SizePreviewText"
                             Text="Aa"
                             FontFamily="{StaticResource Font.UI}" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                </Grid>
                <Slider x:Name="SizeSlider"
                        Style="{StaticResource Field.Slider}"
                        Focusable="False"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        Margin="0,4,0,0"
                        ValueChanged="OnSizeChanged" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Surface.Layer}"
            BorderBrush="{DynamicResource Stroke.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="14,8">
      <DockPanel>
        <TextBlock x:Name="Hint" DockPanel.Dock="Right"
                   Style="{StaticResource Type.Caption}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock x:Name="Status" Style="{StaticResource Type.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Canvas -->
    <ScrollViewer x:Name="Viewport"
                  Background="{DynamicResource Surface.Canvas}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False"
                  PreviewMouseWheel="OnViewportWheel"
                  SizeChanged="OnViewportSizeChanged">
      <Border Padding="28">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- The shadow sits on a sibling rather than an ancestor, so pen
               strokes never force the bitmap effect to re-render the whole image. -->
          <Rectangle Fill="{DynamicResource Surface.Layer}">
            <Rectangle.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" />
            </Rectangle.Effect>
          </Rectangle>
          <Border BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
            <editing:MarkupCanvas x:Name="Markup" />
          </Border>
        </Grid>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
