<Window x:Class="HDRSnip.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp"
        LostMouseCapture="OnLostMouseCapture"
        MouseRightButtonUp="OnCancel">
  <Window.Resources>
    <!-- The overlay always sits on a dark scrim, so its chrome stays dark even
         when Windows is running the light theme. -->
    <ResourceDictionary Source="/HDRSnip;component/Theme/Dark.xaml" />
  </Window.Resources>

  <Grid>

    <!-- The frozen, tone-mapped desktop at native resolution. -->
    <Image x:Name="Frozen"
           Stretch="Fill"
           RenderOptions.BitmapScalingMode="HighQuality" />

    <!-- One path instead of four rectangles: the dim is the outer bounds with
         the selection punched out by the even-odd fill rule, so a drag updates
         a single geometry rather than re-laying-out four elements. -->
    <Path x:Name="Shade" Fill="#73060810" IsHitTestVisible="False">
      <Path.Data>
        <GeometryGroup FillRule="EvenOdd">
          <RectangleGeometry x:Name="ShadeOuter" />
          <RectangleGeometry x:Name="ShadeHole" />
        </GeometryGroup>
      </Path.Data>
    </Path>

    <Canvas x:Name="Layer" IsHitTestVisible="False">

      <Rectangle x:Name="SelectionBox"
                 Stroke="{DynamicResource Accent.Default}"
                 StrokeThickness="1.5"
                 Visibility="Collapsed" />

      <!-- Corner ticks read as a precision tool and survive against any wallpaper. -->
      <Path x:Name="Corners"
            Stroke="{DynamicResource Accent.Default}"
            StrokeThickness="3"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Visibility="Collapsed" />

      <!-- Resize handles, shown only while an adjustable selection is waiting to be confirmed. -->
      <Path x:Name="Handles"
            Fill="White"
            Stroke="{DynamicResource Accent.Default}"
            StrokeThickness="1.5"
            Visibility="Collapsed" />

      <Border x:Name="Loupe"
              Background="{DynamicResource Surface.Overlay}"
              BorderBrush="{DynamicResource Stroke.Strong}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Small}"
              Padding="3"
              Visibility="Collapsed">
        <StackPanel>
          <Grid Width="120" Height="120">
            <Rectangle x:Name="LoupeImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <!-- Frames the single frame pixel under the cursor. -->
            <Rectangle Width="10" Height="10"
                       Stroke="{DynamicResource Accent.Default}" StrokeThickness="1" />
          </Grid>
          <TextBlock x:Name="LoupeLabel" Style="{StaticResource Type.Mono}" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>
      </Border>

      <Border x:Name="SizeBadge"
              Background="{DynamicResource Surface.Overlay}"
              BorderBrush="{DynamicResource Stroke.Default}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Small}"
              Padding="8,4"
              Visibility="Collapsed">
        <TextBlock x:Name="SizeLabel" Style="{StaticResource Type.Mono}" />
      </Border>

      <Border x:Name="Hint"
              Background="{DynamicResource Surface.Overlay}"
              BorderBrush="{DynamicResource Stroke.Default}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Flyout}"
              Padding="16,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}"
                     Text="&#xE123;"
                     Foreground="{DynamicResource Accent.Default}"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="HintText" Style="{StaticResource Type.Body}" Text="Drag to snip, or click a window" VerticalAlignment="Center" />
          <Border Width="1" Height="14" Margin="12,0" Background="{DynamicResource Stroke.Default}" />
          <TextBlock Style="{StaticResource Type.Secondary}" Text="Esc to cancel" VerticalAlignment="Center" />
          <Border x:Name="HdrNoteDivider" Width="1" Height="14" Margin="12,0" Background="{DynamicResource Stroke.Default}" />
          <TextBlock x:Name="HdrNote"
                     Style="{StaticResource Type.Secondary}"
                     Text="HDR tone-mapped"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Window>
