<Window x:Class="HDRSnip.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDRSnip"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        AllowsTransparency="True"
        KeyDown="OnKeyDown">

  <!-- Recent captures of this session. Margin leaves room for the shadow. -->
  <Border Margin="24,16,24,24"
          Background="{DynamicResource Surface.Overlay}"
          BorderBrush="{DynamicResource Stroke.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Flyout}"
          Padding="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000" />
    </Border.Effect>

    <StackPanel>
      <DockPanel Margin="4,0,0,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Click="OnClose" ToolTip="Close (Esc)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="12" />
        </Button>
        <TextBlock Style="{StaticResource Type.Subtitle}" Text="Recent captures" VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource Type.Caption}" Text="This session only — nothing is kept after exit"
                   VerticalAlignment="Center" Margin="12,1,0,0" />
      </DockPanel>
      <WrapPanel x:Name="Items" MaxWidth="900" />
    </StackPanel>
  </Border>
</Window>
