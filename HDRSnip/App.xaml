<Application x:Class="HDRSnip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Slot 0 is the palette. ThemeService swaps this entry for Light.xaml
             when Windows is in light mode; everything downstream binds with
             DynamicResource so the whole UI retints without a restart. -->
        <ResourceDictionary Source="Theme/Dark.xaml" />
        <ResourceDictionary Source="Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
